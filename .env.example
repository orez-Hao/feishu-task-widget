# 用你自己的飞书自建应用（不要用别人的 App ID / Secret）
# 复制成 .env 后填自己的飞书自建应用（https://open.feishu.cn/app）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 重定向 URL 必须和开发者后台「安全设置」里填的一致
FEISHU_REDIRECT_URI=http://localhost:3000/callback

# 可选：数据目录（默认 ~/.feishu-task-widget）
# FEISHU_TASK_DATA=C:\Users\me\.feishu-task-widget
